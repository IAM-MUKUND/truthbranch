# FalkorDB settings
FALKORDB_HOST=localhost
FALKORDB_PORT=6380

# Groq LLM settings (Single key or multiple keys for automated round-robin scheduling)
GROQ_API_KEY=your_groq_api_key_here
# Optional additional keys for free-tier rotation:
# GROQ_API_KEY1=gsk_...
# GROQ_API_KEY2=gsk_...
# GROQ_API_KEY3=gsk_...
# GROQ_API_KEY4=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_HEAVY_MODEL=openai/gpt-oss-120b
GROQ_LIGHT_MODEL=openai/gpt-oss-20b

# Agent mode: 'live' (uses Groq) or 'scripted' (deterministic tool runner for demos/tests)
AGENT_MODE=scripted
