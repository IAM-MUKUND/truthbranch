# FalkorDB settings
FALKORDB_HOST=localhost
FALKORDB_PORT=6380

# Groq LLM settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_HEAVY_MODEL=openai/gpt-oss-120b
GROQ_LIGHT_MODEL=openai/gpt-oss-20b

# Agent mode: 'live' (uses Groq) or 'scripted' (deterministic tool runner for demos/tests)
AGENT_MODE=scripted
